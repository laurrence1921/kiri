{
  "cdiVersion": "0.5.0",
  "kind": "nvidia.com/gpu",
  "devices": [
    {"name": "0", "containerEdits": {"deviceNodes": [{"path": "/dev/fakegpu0", "hostPath": "/dev/null"}]}},
    {"name": "all", "containerEdits": {"deviceNodes": [{"path": "/dev/fakegpu0", "hostPath": "/dev/null"}]}}
  ],
  "containerEdits": {
    "env": ["FAKE_GPU=1"],
    "mounts": [{"hostPath": "/opt/cdi/libfake.so.1.2", "containerPath": "/usr/lib/libfake.so.1.2", "options": ["ro", "bind"]}],
    "hooks": [{"hookName": "createContainer", "path": "/bin/true", "args": ["x", "create-symlinks", "--link", "libfake.so.1.2::/usr/lib/libfake.so.1"]}]
  }
}
